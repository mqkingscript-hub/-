	local v1 = game:GetService("ReplicatedStorage"):WaitForChild("StudioLiteFolder")
	local v2 = game.Players.LocalPlayer.PlayerGui:WaitForChild("StudioGui", 9)
	local v3 = v2:WaitForChild("GrowingUpFrame")
	local v4 = v2:WaitForChild("VoteFrame")
	v3.Visible = false
	v4.Visible = true
	v1.RefreshDonation:FireServer(50)
end)]]></ProtectedString>
