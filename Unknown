-- Map, monsters, combat, coins, levels, pets, rebirth and saving.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local Debris = game:GetService("Debris")
local Store = DataStoreService:GetDataStore("LegoPowerTycoon_V1")

local remotes = ReplicatedStorage:FindFirstChild("LegoPowerRemotes") or Instance.new("Folder")
remotes.Name = "LegoPowerRemotes"; remotes.Parent = ReplicatedStorage
local function remote(name)
    local r = remotes:FindFirstChild(name) or Instance.new("RemoteEvent")
    r.Name = name; r.Parent = remotes; return r
end
local Attack = remote("Attack"); local BuyPet = remote("BuyPet"); local Rebirth = remote("Rebirth")
local Notify = remote("Notify")

local old = workspace:FindFirstChild("LEGO_POWER_WORLD")
if old then old:Destroy() end
local world = Instance.new("Folder"); world.Name = "LEGO_POWER_WORLD"; world.Parent = workspace
local monsterFolder = Instance.new("Folder"); monsterFolder.Name = "Monsters"; monsterFolder.Parent = world
local function part(name, size, pos, color, material, parent)
    local p = Instance.new("Part"); p.Name=name; p.Size=size; p.Position=pos; p.Anchored=true
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Color=color; p.Material=material or Enum.Material.SmoothPlastic; p.Parent=parent or world
    return p
end
local function sign(text, pos, color)
    local p=part("LEGO Sign",Vector3.new(18,7,1),pos,color,Enum.Material.SmoothPlastic)
    local gui=Instance.new("SurfaceGui"); gui.Face=Enum.NormalId.Front; gui.Parent=p
    local label=Instance.new("TextLabel"); label.Size=UDim2.fromScale(1,1); label.BackgroundTransparency=1
    label.Text=text; label.TextScaled=true; label.Font=Enum.Font.FredokaOne; label.TextColor3=Color3.new(1,1,1); label.Parent=gui
end
-- Main LEGO island and paths
part("Main Grass Island",Vector3.new(230,4,180),Vector3.new(0,-2,0),Color3.fromRGB(83,190,91),Enum.Material.Grass)
part("Lobby Plaza",Vector3.new(58,1,48),Vector3.new(0,0,0),Color3.fromRGB(75,190,230))
part("Forest Zone",Vector3.new(62,1,58),Vector3.new(0,0,68),Color3.fromRGB(79,171,77))
part("Arena Zone",Vector3.new(62,1,58),Vector3.new(78,0,68),Color3.fromRGB(180,105,210))
part("Pet Shop Zone",Vector3.new(54,1,44),Vector3.new(-76,0,0),Color3.fromRGB(255,190,70))
part("Rebirth Zone",Vector3.new(54,1,44),Vector3.new(76,0,0),Color3.fromRGB(80,155,255))
part("Upgrade Zone",Vector3.new(48,1,44),Vector3.new(0,0,-62),Color3.fromRGB(255,115,125))
sign("LEGO POWER TYCOON",Vector3.new(0,8,-20),Color3.fromRGB(30,100,210))
sign("MONSTER FOREST",Vector3.new(0,7,43),Color3.fromRGB(30,130,60))
sign("BOSS ARENA",Vector3.new(78,7,43),Color3.fromRGB(125,50,160))
sign("PET SHOP",Vector3.new(-76,7,-15),Color3.fromRGB(220,135,20))
sign("REBIRTH",Vector3.new(76,7,-15),Color3.fromRGB(30,90,200))
sign("UPGRADE",Vector3.new(0,7,-83),Color3.fromRGB(190,45,65))
-- Decorative LEGO trees
for i=1,18 do
    local x=math.random(-100,100); local z=math.random(30,105)
    if math.abs(x)>18 then
        part("LEGO Tree Trunk",Vector3.new(3,9,3),Vector3.new(x,4.5,z),Color3.fromRGB(130,78,42))
        local crown=part("LEGO Tree Crown",Vector3.new(11,10,11),Vector3.new(x,12,z),Color3.fromRGB(math.random(35,65),math.random(135,190),math.random(45,75)))
        crown.Shape=Enum.PartType.Block
    end
