<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

local v_u_1 = script.Parent
local v_u_2 = v_u_1.Parent.Parent
local v_u_3 = game:GetService("ReplicatedStorage"):WaitForChild("StudioLiteFolder"):WaitForChild("ServerFunctions")
function LoadGame(p4, p5) -- name: LoadGame
	-- upvalues: (copy) v_u_3
	local v6 = p5:WaitForChild("Frame1"):WaitForChild("GameTitleTextLabel")
	local v7 = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("StudioGui")
	local v8 = require(v7:WaitForChild("ClearClientWorkspaceModule"))
	local v9 = require(v7:WaitForChild("ClonePathGameToLocalWorkspaceModule"))
	local v10 = require(v7:WaitForChild("CloneStarterGuiForEditOrPlayModule"))
	local v11 = v7:WaitForChild("WarningText")
	v7.OpenSaveFrame.Visible = false
	v11.Text = "Loading " .. v6.Text .. "..."
	v11.Visible = true
	v_u_3:InvokeServer("LoadDbGameToPlayerGui", p4)
	v8:ClearWorkspace()
	v9:Load(game.Players.LocalPlayer.PlayerGui:FindFirstChild(v6.Text))
	v10:Edit()
	v11.Text = "Ready"
	v_u_3:InvokeServer("ClearGameFromPlayerGui")
	task.wait(1)
	v11.Visible = false
end
function SaveGame(p12, p13) -- name: SaveGame
	local v14 = p13:WaitForChild("Frame1"):WaitForChild("GameTitleTextLabel")
	local v15 = p13:WaitForChild("Frame3"):WaitForChild("DescriptionTextLabel")
	local v16 = p13:WaitForChild("Frame3"):WaitForChild("PublishedTFValue")
	local v17 = p13:WaitForChild("Frame4"):WaitForChild("ShareFromOwnerStringValue")
	local v18 = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("StudioGui", 9):WaitForChild("TopBar"):WaitForChild("SaveDetailsFrame")
	if #workspace:GetChildren() < 9 and #_G.sss:GetChildren() == 0 then
		_G.DialogAnswer = "?"
		local v19 = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("StudioGui", 9):WaitForChild("DialogYesNoFrame")
		v19:WaitForChild("YesNoTextLabel").Text = "WARNING: Are you sure you want to overwrite your previous work with a mostly empty baseplate?"
		v19.Visible = true
		while _G.DialogAnswer == "?" do
			task.wait(0.2)
		end
		if _G.DialogAnswer == "No" then
			return
		end
	end
	v18:WaitForChild("GameNameTextBox").Text = v14.Text
	v18:WaitForChild("DescriptionTextBox").Text = v15.Text
	if v16.Value then
		v18:WaitForChild("PublishCheckboxImageButton").Image = "http://www.roblox.com/asset/?id=48138491"
		v18:WaitForChild("PublishDescTextLabel").Text = "(Everyone can play it together.)"
	else
		v18:WaitForChild("PublishCheckboxImageButton").Image = "http://www.roblox.com/asset/?id=48138474"
		v18:WaitForChild("PublishDescTextLabel").Text = "(Save for later.)"
	end
	v18:WaitForChild("OwnerTextLabel").Text = v17.Value
	v18:WaitForChild("GameNumberValue").Value = p12
	v18.Visible = true
end
v_u_1.Activated:Connect(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_1
	local v20, v21 = v_u_2.Name:match("(%a+)(%d.*)")
	if v20 and v21 then
		if v_u_1.Text == "Open" then
			LoadGame(v21, v_u_2)
			return
		end
		if v_u_1.Text:sub(1, 4) == "Save" then
			SaveGame(v21, v_u_2)
			return
		end
		if v_u_1.Text:sub(1, 7) == "Restore" then
			LoadGame(v_u_2.Name, v_u_2)
			return
		end
		print("unexpected OpenSaveButton.Text", v_u_1.Text)
	end
end)]]></ProtectedString>
