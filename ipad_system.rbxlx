				<ProtectedString name="Source"><![CDATA[-- iPadServer: loads every server module of the iPad system.
-- Place in ServerScriptService. The tool "iPad" must be in StarterPack.
local StarterPack = game:GetService("StarterPack")
local tool = StarterPack:WaitForChild("iPad")
local serverModules = tool:WaitForChild("ServerModules")

-- WordList is only a data module (required by the others), no need to load it directly
local skip = { WordList = true }

for _, module in ipairs(serverModules:GetChildren()) do
	if module:IsA("ModuleScript") and not skip[module.Name] then
		task.spawn(function()
			local ok, err = pcall(require, module)
			if not ok then
				warn("[iPadServer] failed to load " .. module.Name .. ": " .. tostring(err))
			end
		end)
	end
end
]]></ProtectedString>
