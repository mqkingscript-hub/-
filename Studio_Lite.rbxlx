<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

script.Parent.MouseButton1Click:Connect(function()
	local v1 = script.Parent.Parent
	v1.Visible = false
	local v2 = Instance.new("Frame")
	v2.Position = UDim2.new(0, v1.AbsolutePosition.X, 0, v1.AbsoluteSize.Y)
	v2.Size = v1.Size
	v2.BackgroundColor3 = v1.BackgroundColor3
	v2.ZIndex = v1.ZIndex
	v2.Parent = v1.Parent
	v2:TweenSizeAndPosition(UDim2.new(0, v1.Parent.TopBar.TUTORIALS.AbsoluteSize.X, 0, v1.Parent.TopBar.TUTORIALS.AbsoluteSize.Y), UDim2.new(0, v1.Parent.TopBar.TUTORIALS.AbsolutePosition.X, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.4)
	task.wait(0.4)
	v2:Destroy()
end)]]></ProtectedString>
