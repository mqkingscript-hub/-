<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

script.Parent.MouseButton1Click:Connect(function()
	local v1 = game.Players.LocalPlayer.PlayerGui:WaitForChild("StudioGui", 9)
	local v2 = v1:WaitForChild("TopBar"):WaitForChild("FileMenu")
	local v3 = v1:WaitForChild("OpenSaveFrame")
	local v4 = v1.TopBar:WaitForChild("OpenSamplesMenu")
	local v5 = v1.TopBar:WaitForChild("SaveDetailsFrame")
	local v6 = v1:WaitForChild("ViewScriptFrame")
	local v7 = v1:WaitForChild("ToolboxFrame")
	local v8 = v1:WaitForChild("MainBar"):WaitForChild("sel")
	local v9 = v1:WaitForChild("InsertScriptFrame")
	local v10 = v1:WaitForChild("InsertLocalScriptFrame")
	local v11 = v1:WaitForChild("GrowingUpFrame")
	local v12 = v1:WaitForChild("SplashFrame")
	v2.Visible = false
	v3.Visible = false
	v4.Visible = false
	v5.Visible = false
	v6.Visible = false
	v7.Visible = false
	v8.Visible = false
	v9.Visible = false
	v10.Visible = false
	v12.Visible = false
	local v13 = 0
	for _, v14 in pairs(_G.badgesYN) do
		if v14 ~= "Y" then
			continue
		end
		v13 = v13 + 1
	end
	local v15 = v11:WaitForChild("LinesFrame"):WaitForChild("Line2")
	if v13 >= 1 then
		v15.Text = "Congratulations!  You completed the age 20 college class in \226\128\156Growing Up\226\128\157.  Or you can stay and learn more."
	else
		v15.Text = "You must complete one tutorial here in \226\128\156Studio Lite\226\128\157 to pass the age 20 college class in \226\128\156Growing Up\226\128\157."
	end
	v11.Visible = true
end)]]></ProtectedString>
