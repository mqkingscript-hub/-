local v_u_3 = script.Parent.Parent.Parent:WaitForChild("Frame3")
local v_u_4 = script.Parent.Parent.Parent:WaitForChild("Frame4")
v2:WaitForChild("MoreButton")
local v_u_5 = v2:WaitForChild("NearMoreTextLabel")
local v_u_6 = v_u_4:WaitForChild("NearShareTextLabel")
script.Parent.Activated:Connect(function()
	-- upvalues: (copy) v_u_3, (copy) v_u_6, (copy) v_u_5, (copy) v_u_4, (copy) v_u_1
	if v_u_3.Visible then
		if #v_u_6.Text > 1 then
			local v7 = v_u_5.Text
			local v8 = v_u_5.BackgroundColor3
			v_u_5.Text = v_u_6.Text
			v_u_5.BackgroundColor3 = v_u_6.BackgroundColor3
			v_u_6.Text = v7
			v_u_6.BackgroundColor3 = v8
		end
		v_u_3.Visible = false
		v_u_4.Visible = false
		script.Parent.Text = "More..."
	else
		if #v_u_6.Text > 1 then
			local v9 = v_u_5.Text
			local v10 = v_u_5.BackgroundColor3
			v_u_5.Text = v_u_6.Text
			v_u_5.BackgroundColor3 = v_u_6.BackgroundColor3
			v_u_6.Text = v9
			v_u_6.BackgroundColor3 = v10
		end
		if v_u_4.ShareButton.Text == "Share" then
			v_u_4.DeleteButton.Visible = true
		else
			v_u_4.DeleteButton.Visible = false
		end
		v_u_3.Visible = true
		if v_u_1.Text:sub(1, 7) == "Restore" then
			v_u_4.Visible = false
		else
			v_u_4.Visible = true
		end
		script.Parent.Text = "Less..."
	end
end)]]></ProtectedString>
