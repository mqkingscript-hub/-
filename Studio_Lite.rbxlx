<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

game:GetService("MarketplaceService")
local v1 = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("StudioGui", 9):WaitForChild("ExplorerPanel")
local v_u_2 = v1:WaitForChild("SetSelection")
local v_u_3 = v1:WaitForChild("GetSelection")
script.Parent.Activated:Connect(function()
	-- upvalues: (copy) v_u_3, (copy) v_u_2
	local v4 = script.Parent.Parent.AssetTextBox.Text:match("%d+")
	if v4 and tonumber(v4) > 999 then
		local v5 = Instance.new("Decal")
		v5.Name = "Decal"
		v5.Texture = "rbxthumb://type=Asset&id=" .. tostring(v4) .. "&w=420&h=420"
		local v6 = v_u_3:Invoke()
		if v6 and (typeof(v6) == "table" and (#v6 >= 1 and v6[1]:IsA("BasePart"))) then
			v5.Parent = v6[1]
			task.wait(0.2)
			v_u_2:Invoke({ v5 })
		else
			warn("First select a part to insert the decal into.")
		end
	else
		warn("Enter an asset number from the URL at create.roblox.com/store")
		return
	end
end)]]></ProtectedString>
