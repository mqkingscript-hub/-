<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

local v_u_1 = game:GetService("MarketplaceService")
local v2 = game.Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("StudioGui", 9):WaitForChild("ExplorerPanel")
local v_u_3 = v2:WaitForChild("SetSelection")
local v_u_4 = v2:WaitForChild("GetSelection")
script.Parent.Activated:Connect(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_4, (copy) v_u_3
	local v5 = script.Parent.Parent.AssetTextBox.Text:match("%d+")
	if v5 and tonumber(v5) > 999 then
		local v6 = v_u_1:GetProductInfoAsync(v5)
		if v6 and v6.Name then
			local v7 = Instance.new("Sound")
			v7.Name = v6.Name
			v7.SoundId = "rbxassetid://" .. tostring(v5)
			local v8 = v_u_4:Invoke()
			if v8 and (typeof(v8) == "table" and #v8 >= 1) then
				v7.Parent = v8[1]
			else
				v7.Parent = workspace
			end
			v7.Playing = true
			task.wait(0.2)
			v_u_3:Invoke({ v7 })
		else
			warn("MeshPart asset# not found.  Find the asset number in the URL at create.roblox.com/store")
		end
	else
		warn("Enter an asset number from the URL at create.roblox.com/store")
		return
	end
end)]]></ProtectedString>
