    local function drawSearch(v142)
        local v143 = {}
        for v144 in string.gmatch(string.lower(v142), "%S+") do
            table.insert(v143, v144)
        end
        local v145 = {}
        for v146, v147 in Websites.Pages do
            local v148 = {
                v146,
                v147.title,
                v147.keywords or ""
            }
            local v149 = ""
            for v150, v151 in v147.blocks do
                local text = v151.text
                if type(text) == "string" then
                    local text = v151.text
                    table.insert(v148, text)
                    if v149 == "" and v151.type == "text" then
                        v149 = v151.text
                    end
                end
                local title = v151.title
                if type(title) == "string" then
                    local title = v151.title
                    table.insert(v148, title)
                end
                for v152, v153 in v151.items or {} do
                    local v154 = if type(v153) == "string" then v153 else (v153.title or "") .. " " .. (v153.text or "")
                    table.insert(v148, v154)
                end
            end
            local v155 = string.lower(table.concat(v148, " "))
            local v156 = #v143 > 0
            for v157, v158 in v143 do
                if not string.find(v155, v158, 1, true) then
                    v156 = false
                    break
                end
            end
            if v156 then
                local v159 = {
                    site = v146,
                    page = v147,
                    snippet = v149
                }
                table.insert(v145, v159)
            end
        end
        table.sort(v145, function(v160, v161) -- line 795
            return v160.page.title < v161.page.title
        end)
        words("Search Results", 30, UI.INK, Enum.FontWeight.Bold)
        local v162 = if #v145 == 1 then "1 page found" else #v145 .. " pages found"
        words(v162, 15, UI.GRAY)
        if #v145 == 0 then
            words("No pages match your search. Try fewer or different words.", 18, v2)
        end
        for v163, v164 in v145 do
            local v165 = {
                BackgroundColor3 = UI.LINE,
                Size = UDim2.new(1, 0, 0, 1)
            }
            v50 += 1
            v165.LayoutOrder = v50
            v165.Parent = v48
            make("Frame", v165, nil)
            words(v164.site, 14, Color3.fromRGB(34, 139, 74))
            linkTo(v164.page.title, v164.site).TextSize = 21
            if v164.snippet ~= "" then
                local snippet = v164.snippet
                local v166 = string.gsub(game.Name, " @ .*$", "")
                local v167 = string.gsub(snippet, "{player}", LocalPlayer.DisplayName)
                local v168 = string.gsub(v167, "{game}", v166)
                if #v168 > 150 then
                    v168 = string.sub(v168, 1, 150) .. "..."
                end
                words(v168, 16, v2)
            end
        end
    end

