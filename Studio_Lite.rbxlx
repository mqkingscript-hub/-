<string name="Text">----------------------------------------------------------------------------------------
--  AnimationLitePlayScript  --  This Script is automatically inserted into a Rig by  --
--  Studio Lite's "Animation Lite" if checkmarked while saving the KeyframeSequence.  --
--  You are free to change this script, place it inside Players, trigger it by GUI    --
--  or play it when a part is touched or a tool is equipped. Be sure to change the    --
--  script name so the checkmark in Animation Lite won't overwrite your work.         --
--                                                 --ScottSpiritWalker, 10/30/2025.   --
----------------------------------------------------------------------------------------

local AnimationLitePlayEvent = game.ServerScriptService.AnimationLiteService.AnimationLitePlayEvent
task.wait(1)  --wait for server to start so you can see the animation.
AnimationLitePlayEvent:Fire(script.Parent, script.KeyframeSequence.Value,1)   --Start playing animation and continue this script.  
--Parameters: rig, KeyframeSequence, speed=1, startKeyframe=1 and endKeyframe=9999
--The last two parameters can be used to pose a statue frozen at a particular frame number.


--------Request Stop playing an animation early, or stop a looped animation.
--while script.Parent:GetAttribute("AnimationLitePlaying") ~= nil do --stop currently playing animation if any.
--	script.Parent:SetAttribute("AnimationLitePlaying",false)
--	task.wait()
--end


--repeat	 --Wait for a non looped animation to end.
--	task.wait(.1)	
--until script.Parent:GetAttribute("AnimationLitePlaying") == nil

--The above examples are for NPC rigs. 


----------To fire this animation from a GUI button:
----------You will need a LocalScript in each Gui button (if more than one), something like these five lines:
--local AnimationLiteGuiActivated = game.ReplicatedStorage:WaitForChild("AnimationLiteGuiActivated",9999)
--local guiButton = script.Parent
--guiButton.Activated:Connect(function()
--	AnimationLiteGuiActivated:FireServer("happy dance")  --Incase you have several animation buttons, you can pass the name to identify which to play.
--end)

----------Next you need a Script in ServerScriptServices something like this:
--local AnimationLitePlayEvent = game.ServerScriptService.AnimationLiteService.AnimationLitePlayEvent
--local AnimationLiteGuiActivated = script:FindFirstChild("AnimationLiteGuiActivated")
--if not AnimationLiteGuiActivated then
--	AnimationLiteGuiActivated = Instance.new("RemoteEvent")
--	AnimationLiteGuiActivated.Name = "AnimationLiteGuiActivated"                 
--	AnimationLiteGuiActivated.Parent = game.ReplicatedStorage
--end
--local paused = false   --Debounce to prevent other animation play request until this one is started.
--AnimationLiteGuiActivated.OnServerEvent:Connect(function(player,whichAnim)    --Triggered when a LocalScript calls FireServer. 
--	if not paused and player and player.Character then
--		paused = true
--		while player.Character:GetAttribute("AnimationLitePlaying") ~= nil do --stop currently playing animation if any.
--			player.Character:SetAttribute("AnimationLitePlaying",false)
--			task.wait()
--		end
--		AnimationLitePlayEvent:Fire(player.Character, game.ServerStorage.RBX_ANIMSAVES[whichAnim],1)
--		paused = false
--	end
--end)



----------If you want to replace the player's default run, idle, swim, etc, with your own custom animations:
----------You will need a LocalScript in StarterCharacterScripts something like this to capture changes to the player's state:
--local AnimationLiteRemoteTrigger = game.ReplicatedStorage:WaitForChild("AnimationLiteRemoteTrigger",9999)
--local char = script.Parent
--char:WaitForChild("Animate").Enabled = false   --Stop Roblox character animations.
--local humanoid = char:WaitForChild("Humanoid")
--for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
--	track:Stop()
--end
--while task.wait(.1) do 
--	if humanoid.MoveDirection.magnitude &lt; .1 then
--		task.wait()  --Give non looped anims priority.
--		if currentAnim ~= "idle" and currentAnim ~= "pause" then
--			currentAnim = "idle"
--			AnimationLiteRemoteTrigger:FireServer("myIdle",false) --false means this is a looped anim that needs to be stopped at some point.
--		end
--	else
--		task.wait() --Give npn looped priority if both happen.
--		if currentAnim ~= "running" and currentAnim ~= "pause"  then
--			currentAnim = "running"
--			AnimationLiteRemoteTrigger:FireServer("myRun",false)
--		end
--	end
--	if humanoid.Jump then
--		if currentAnim ~= "pause" then
--			currentAnim = "pause" --pause other animations until this one finishs.
--			AnimationLiteRemoteTrigger:FireServer("myJump",true)  --true means not looped, wait for it to finish before playing other anims.
--			task.wait(1)
--			currentAnim = "none"
--		end
--	end
--end

----------Next you need a Script in ServerScriptServices something like this to play the remotely triggered animation:
--local AnimationLitePlayEvent = game.ServerScriptService.AnimationLiteService.AnimationLitePlayEvent
--local AnimationLiteRemoteTrigger = script:FindFirstChild("AnimationLiteRemoteTrigger")
--if not AnimationLiteRemoteTrigger then
--	AnimationLiteRemoteTrigger = Instance.new("RemoteEvent")
--	AnimationLiteRemoteTrigger.Name = "AnimationLiteRemoteTrigger"                 
--	AnimationLiteRemoteTrigger.Parent = game.ReplicatedStorage
