-- Colored brick decorations around the plaza
for i=1,12 do
    local x=-25+(i%6)*10; local z=-16+math.floor(i/6)*32
    local b=part("Colorful LEGO Brick",Vector3.new(5,2,5),Vector3.new(x,2,z),Color3.fromHSV(i/12,0.8,1))
    for j=1,4 do
        local stud=part("Brick Stud",Vector3.new(1,0.5,1),b.Position+Vector3.new(-1.8+(j-1)*1.2,1.25,0),b.Color)
    end
