		v687.Image = "rbxassetid://87351486351798"
		playingAnim = false
		modal = false
		for _, v691 in pairs(partList) do
			if v691.Motor6D == nil then
				continue
			end
			v691.Motor6D.CurrentAngle = 0
			v691.Motor6D.C1 = v691.OriginC1
		end
