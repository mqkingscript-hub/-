local v_u_1 = game:GetService("ReplicatedStorage"):WaitForChild("StudioLiteFolder"):WaitForChild("TpBackToGrowingUpServerFunction")
script.Parent.Activated:Connect(function()
	-- upvalues: (copy) v_u_1
	local v2 = game.Players.LocalPlayer.PlayerGui:WaitForChild("StudioGui", 9)
	local v3 = v2:WaitForChild("SplashFrame")
	local v4 = v2:WaitForChild("GrowingUpFrame")
	local v5 = v2:WaitForChild("TutorialFrame")
	v4.Visible = false
	v3.Visible = false
	v5:WaitForChild("TextButton1").Visible = false
	v5:WaitForChild("TextButton2").Visible = false
	v5:WaitForChild("MenuFrame").Visible = false
	v5:WaitForChild("LinesFrame"):WaitForChild("Lines").Text = "\'Growing Up\' loading..."
	v5.Position = UDim2.new(0.3, 0, 0.35, 0)
	v5.Size = UDim2.new(0.4, 0, 0, 80)
	v5.Visible = true
	v_u_1:InvokeServer()
end)]]></ProtectedString>
