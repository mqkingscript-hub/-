                v210[v214.name] = true
            end
        end
    end
    for v215, v216 in Config.AppStore.Apps or {} do
        if not v210[v216.name] then
            local v217 = { v216 }
            table.insert(v205, v217)
            v210[v216.name] = true
        end
    end
    return v205
end

local function apps(v218, v219, v220, v221)
    local v222 = {}
