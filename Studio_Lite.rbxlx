																									v_u_19.Text = "local spLoc = game.Workspace.SpawnLocation\nwait(.5)                    --Pause one second.\nspLoc.Transparency = 1     --1 means transparent.\nspLoc.CanCollide = false   --false means no checkmark. Fall through.\nwait(.5)                    --Pause one second.\nspLoc.Transparency = 0     --0 means not transparent.\nspLoc.CanCollide = true    --true means checked. Can stand on it.\nwait(.5)\nspLoc.Transparency = 1\nspLoc.CanCollide = false\nwait(.5)\nspLoc.Transparency = 0\nspLoc.CanCollide = true\nwait(.5)\nspLoc.Transparency = 1\nspLoc.CanCollide = false\nwait(.5)\nspLoc.Transparency = 0\nspLoc.CanCollide = true\nprint(\"done.\")"
