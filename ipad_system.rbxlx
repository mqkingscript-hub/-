            })
        })
        v92.Activated:Connect(function()
            Preferences.set(v86, not Preferences.get(v86))
        end)
        v88(v87, Preferences.changed:Connect(function(v96, v97)
            if v96 ~= v86 then
                return
            end
            local v98 = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local v99 = {}
            if v97 then
                v99.BackgroundColor3 = UI.GREEN
            else
                v99.BackgroundColor3 = v7
            end
            TweenService:Create(v92, v98, v99):Play()
            local v100 = {}
            local new = UDim2.new
            local v101 = if v97 then 22 else 2
            v100.Position = new(0, v101, 0.5, 0)
            TweenService:Create(v95, v98, v100):Play()
        end))
    end

    local function slider(v102, v103, v104)
        local function v105(v106, ...)
            table.insert(v106, ...)
        end

        local function v107(v108, ...)
            table.insert(v108, ...)
        end

        local function v109(v110, ...)
            table.insert(v110, ...)
        end

        local function fraction()
            local v111 = (Preferences.get(v103.key) - v103.min) / (v103.max - v103.min)
            return (math.clamp(v111, 0, 1))
        end

        if v103.ends == "sun" then
            for v112, v113 in {
                    {
                        x = 26,
                        scale = 0.62
                    },
                    {
                        x = -26,
                        scale = 0.95
                    }
                } do
                local v114 = {
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0.5, 0.5)
                }
                local new = UDim2.new
                local v115 = if v113.x > 0 then 0 else 1
                v114.Position = new(v115, v113.x, 0.5, 0)
                v114.Size = UDim2.fromOffset(30, 30)
                v114.Parent = v102
                local v116 = make("Frame", v114, { make("UIScale", { Scale = v113.scale }) })
                local v117 = Glyphs.pen(v116, UI.WHITE)
                for v118 = 0, 7 do
                    local v119 = v118 * 45
                    local v120 = math.rad(v119)
                    local v121 = math.cos(v120)
                    local v122 = math.sin(v120)
                    v117.line(v121 * 8.5, v122 * 8.5, v121 * 11, v122 * 11, 2, UI.GRAY)
                end
                v117.dot(0, 0, 11, UI.GRAY)
            end
        else
            for v123, v124 in {
                    {
                        x = 26,
                        size = 14
                    },
                    {
                        x = -26,
                        size = 24
                    }
                } do
                local v125 = {
                    Text = "A",
                    FontFace = font(Enum.FontWeight.Medium),
                    TextColor3 = UI.GRAY,
                    TextSize = v124.size,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    AnchorPoint = Vector2.new(0.5, 0.5)
                }
                local new = UDim2.new
                local v126 = if v124.x > 0 then 0 else 1
                v125.Position = new(v126, v124.x, 0.5, 0)
                v125.Size = UDim2.fromOffset(30, 30)
                v125.Parent = v102
                text(v125)
            end
        end
        local v127 = make("TextButton", {
            Name = "Track",
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            ZIndex = 2,
            Position = UDim2.fromOffset(52, 0),
            Size = UDim2.new(1, -104, 1, 0),
            Parent = v102
        })
        local v128 = make("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Color3.fromRGB(209, 209, 214),
            Position = UDim2.new(0, 14, 0.5, 0),
            Size = UDim2.new(1, -28, 0, 4),
            Parent = v127
        }, { round() })
        local v129 = { BackgroundColor3 = UI.BLUE }
        local fromScale = UDim2.fromScale
        local v130 = (Preferences.get(v103.key) - v103.min) / (v103.max - v103.min)
        v129.Size = fromScale(math.clamp(v130, 0, 1), 1)
        v129.Parent = v128
        local v131 = make("Frame", v129, { round() })
        local v132 = {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = UI.WHITE
        }
        local fromScale_2 = UDim2.fromScale
        local v133 = (Preferences.get(v103.key) - v103.min) / (v103.max - v103.min)
        v132.Position = fromScale_2(math.clamp(v133, 0, 1), 0.5)
        v132.Size = UDim2.fromOffset(28, 28)
        v132.Parent = v128
        local v134 = make("Frame", v132, {
            round(),
            make("UIStroke", {
                Transparency = 0.82,
                Thickness = 1,
                Color = UI.BLACK
            })
        })
        local v135

        local function drag(v136)
            local v137 = UI.pointer(v128, v136)
            if v137 == nil or v128.AbsoluteSize.X <= 0 then
                return
            end
            local v138 = (v137.X - v128.AbsolutePosition.X) / v128.AbsoluteSize.X
            local v139 = math.clamp(v138, 0, 1)
            local v140 = (v103.min + v139 * (v103.max - v103.min)) / v103.step
            local v141 = math.round(v140) * v103.step
            local min = v103.min
            local max = v103.max
            local v142 = math.clamp(v141, min, max)
            Preferences.set(v103.key, v142)
        end

        UI.watch(v127).InputBegan:Connect(function(v143)
            if v143.UserInputType == Enum.UserInputType.MouseButton1 then
                v135 = true
                drag(v143)
            elseif v143.UserInputType == Enum.UserInputType.Touch then
                v135 = v143
                drag(v143)
            end
        end)
        v105(v104, UI.InputChanged:Connect(function(v144)
            if not (v135 == true and v144.UserInputType == Enum.UserInputType.MouseMovement) then
                if v135 ~= nil and v135 == v144 then
                    drag(v144)
                end
            else
                drag(v144)
            end
        end))
        v107(v104, UI.InputEnded:Connect(function(v145)
            if v135 == true and v145.UserInputType == Enum.UserInputType.MouseButton1 or not (v135 ~= v145) then
                v135 = nil
            end
        end))
        v109(v104, Preferences.changed:Connect(function(v146)
            if v146 ~= v103.key then
                return
            end
            local fromScale = UDim2.fromScale
            local v147 = (Preferences.get(v103.key) - v103.min) / (v103.max - v103.min)
            v131.Size = fromScale(math.clamp(v147, 0, 1), 1)
            local fromScale_2 = UDim2.fromScale
            local v148 = (Preferences.get(v103.key) - v103.min) / (v103.max - v103.min)
            v134.Position = fromScale_2(math.clamp(v148, 0, 1), 0.5)
        end))
    end

    local function drawRow(v149, v150, v151, v152, v153, v154)
        local v155 = {
            Text = "",
            AutoButtonColor = false
        }
        if v152.title == "" then
