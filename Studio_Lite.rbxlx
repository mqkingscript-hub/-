<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

script.Parent.Activated:Connect(function()
	local v1 = game.Players.LocalPlayer.PlayerGui:WaitForChild("StudioGui", 9)
	local v2 = v1:WaitForChild("PublishedFrame")
	local v3 = v1:WaitForChild("GrowingUpFrame")
	local v4 = v1:WaitForChild("VoteFrame")
	v3.Visible = false
	v4.Visible = false
	v2.Visible = true
end)]]></ProtectedString>
