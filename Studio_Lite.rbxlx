script.Parent.MouseButton1Click:Connect(function()
	local v1 = game.Players.LocalPlayer.PlayerGui:WaitForChild("StudioGui", 9)
	local v2 = v1:WaitForChild("SplashFrame")
	local v3 = v1:WaitForChild("TopBar"):WaitForChild("FileMenu")
	local v4 = v1:WaitForChild("OpenSaveFrame")
	local v5 = v1.TopBar:WaitForChild("OpenSamplesMenu")
	local v6 = v1.TopBar:WaitForChild("SaveDetailsFrame")
	local v7 = v1:WaitForChild("ViewScriptFrame")
	local v8 = v1:WaitForChild("ToolboxFrame")
	local v9 = v1:WaitForChild("MainBar"):WaitForChild("sel")
	local v10 = v1:WaitForChild("InsertScriptFrame")
	local v11 = v1:WaitForChild("InsertLocalScriptFrame")
	v2.Visible = false
	v3.Visible = false
	v4.Visible = false
	v5.Visible = false
	v6.Visible = false
	v7.Visible = false
	v9.Visible = false
	v10.Visible = false
	v11.Visible = false
	if v8.Visible == true then
		v8.Visible = false
	else
		v8.Visible = true
	end
end)]]></ProtectedString>
