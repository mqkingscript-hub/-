<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

local v_u_1 = game:GetService("ReplicatedStorage"):WaitForChild("StudioLiteFolder"):WaitForChild("GetGroupPlacesServerFunction")
local v_u_2 = script.Parent.Parent.Parent.Parent.PublishFrame
local v_u_3 = v_u_2.PublishToButton
local v_u_4 = v_u_2.ReplaceButton
local v_u_5 = v_u_2:WaitForChild("PrivatePlaceIdTextBox")
local v_u_6 = v_u_2:WaitForChild("PrivateUniverseIdTextBox")
local v_u_7 = v_u_2:WaitForChild("PrivatePlaceIdTextLabel")
local v_u_8 = v_u_2:WaitForChild("PrivateUniverseIdTextLabel")
script.Parent.Activated:Connect(function()
	-- upvalues: (copy) v_u_3, (copy) v_u_4, (copy) v_u_5, (copy) v_u_6, (copy) v_u_7, (copy) v_u_8, (copy) v_u_1, (copy) v_u_2
	script.Parent.Parent.Visible = false
	if v_u_3.Text ~= script.Parent.Text then
		v_u_3.Text = script.Parent.Text
		v_u_4.Text = "   Loading..."
		script.Parent.Parent.Visible = false
		v_u_4.Visible = true
		v_u_5.Visible = false
		v_u_6.Visible = false
		v_u_7.Visible = false
		v_u_8.Visible = false
		local v9 = v_u_1:InvokeServer()
		if v9 then
			local v10 = v_u_2.PlaceChoicesFrame
			for _, v11 in ipairs(v10:GetChildren()) do
				if v11.Name ~= "clone" then
					continue
				end
				v11:Destroy()
			end
			for v12, v13 in ipairs(v9.data) do
				local v14 = v13.name
				local v15 = " - " .. (v13.description or "")
				local v16 = 50 - #v13.name
				local v17 = v14 .. v15:sub(1, (math.clamp(v16, 0, 50)))
				if v12 == 1 then
					v_u_4.Text = v17
					v_u_4.universeValue.Value = v13.id
					v_u_4.placeValue.Value = v13.rootPlace.id
					v10.Place.Text = v17
					v10.Place.universeValue.Value = v13.id
					v10.Place.placeValue.Value = v13.rootPlace.id
				else
					local v18 = v10.Place:Clone()
					v18.Name = "clone"
					v18.LayoutOrder = v12
					v18.Text = v17
					v18.universeValue.Value = v13.id
					v18.placeValue.Value = v13.rootPlace.id
					v18.Parent = v10
				end
			end
		end
		if v_u_4.Text == "   Loading..." then
			v_u_4.Text = "Your game must be Public and your group must be Primary."
			v_u_4.universeValue.Value = ""
			v_u_4.placeValue.Value = ""
			warn("Make your game public in the Roblox Creator Hub, and make your Community Primary with the (...) near community name. Or choose Publish to Private.")
		end
	end
end)]]></ProtectedString>
