        v155.BackgroundColor3 = UI.BLUE
        if v153 then
            v155.BackgroundTransparency = 0
        else
            v155.BackgroundTransparency = 1
        end
        v155.Position = UDim2.fromOffset(0, (v150 - 1) * 46)
        v155.Size = UDim2.new(1, 0, 0, 46)
        v155.Parent = v149
        local v156 = make("TextButton", v155, { corner(12) })
        if v152.slider then
            slider(v156, v152.slider, v154)
        else
            local v157
            if v152.glyph and v152.color then
                local v158 = Glyphs.icon(v156, v152.glyph, v152.color, 30)
                v158.AnchorPoint = Vector2.new(0, 0.5)
                v158.Position = UDim2.new(0, 14, 0.5, 0)
                v157 = 56
            elseif v152.image then
                local v159 = { BackgroundTransparency = 1 }
                v159.Image = v152.image
                v159.AnchorPoint = Vector2.new(0, 0.5)
                v159.Position = UDim2.new(0, 14, 0.5, 0)
                v159.Size = UDim2.fromOffset(30, 30)
                v159.Parent = v156
                make("ImageLabel", v159, { corner(7) })
                v157 = 56
            else
                v157 = 16
            end
            local v160
            if v152.toggle then
                switch(v156, v152.toggle, v154)
                v160 = 76
            else
                v160 = 16
            end
            local v161
            if v152.page then
                local v162 = {
                    Text = "\226\128\186",
                    TextSize = 24
                }
                if v153 then
                    v162.TextColor3 = UI.WHITE
                else
                    v162.TextColor3 = Color3.fromRGB(196, 196, 199)
                end
                v162.TextXAlignment = Enum.TextXAlignment.Right
                v162.Position = UDim2.new(1, -36, 0, -2)
                v162.Size = UDim2.new(0, 22, 1, 0)
                v162.Parent = v156
                text(v162)
                v161 = 34
            else
                v161 = v160
            end
            if v152.checked and v152.checked() then
                local v163 = make("Frame", {
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -14, 0.5, 0),
                    Size = UDim2.fromOffset(22, 22),
                    Parent = v156
                })
                local v164 = Glyphs.pen(v163, UI.WHITE)
                v164.line(-6, 0.5, -2, 5, 2.4, UI.BLUE)
                v164.line(-2, 5, 6.5, -5, 2.4, UI.BLUE)
                v161 = 46
            end
            local value = v152.value
            if type(value) == "function" then
                value = value()
            end
            if value then
                local v165 = {
                    Name = "Value",
                    TextSize = 17,
                    Text = value
                }
                if v153 then
                    v165.TextColor3 = UI.WHITE
                else
                    v165.TextColor3 = UI.VALUE
                end
                v165.TextTruncate = Enum.TextTruncate.AtEnd
                v165.TextXAlignment = Enum.TextXAlignment.Right
                v165.Position = UDim2.new(0.4, 0, 0, 0)
                v165.Size = UDim2.new(0.6, -v161, 1, 0)
                v165.Parent = v156
                text(v165)
            end
            local v166 = {
                Name = "Title",
                TextSize = 17,
                Text = v152.title
            }
            if v153 then
                v166.TextColor3 = UI.WHITE
            else
                v166.TextColor3 = v152.tint or UI.INK
            end
            v166.TextTruncate = Enum.TextTruncate.AtEnd
            if v152.center then
                v166.TextXAlignment = Enum.TextXAlignment.Center
            else
                v166.TextXAlignment = Enum.TextXAlignment.Left
            end
            local fromOffset = UDim2.fromOffset
            local v167 = if v152.center then 0 else v157
            v166.Position = fromOffset(v167, 0)
            if v152.center then
                v166.Size = UDim2.fromScale(1, 1)
            elseif value then
                v166.Size = UDim2.new(0.62, -v157, 1, 0)
            else
                v166.Size = UDim2.new(1, -v157 - v161, 1, 0)
            end
            v166.Parent = v156
            text(v166)
            if v150 < v151 and not v153 then
                make("Frame", {
                    BackgroundColor3 = UI.LINE,
                    Position = UDim2.new(0, v157, 1, -1),
                    Size = UDim2.new(1, -v157, 0, 1),
                    Parent = v156
                })
            end
        end
        v156.Activated:Connect(function()
            if v152.action then
                v152.action()
            end
        end)
        return v156
    end

    local function stacker(v168, v169, v170)
        local v171 = 0

