-- Spawn
local spawn=Instance.new("SpawnLocation"); spawn.Name="LEGO Spawn"; spawn.Size=Vector3.new(10,1,10); spawn.Position=Vector3.new(0,1,0)
spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=0; spawn.Color=Color3.fromRGB(255,220,70); spawn.Parent=world

local function statsFor(player)
    local ls=Instance.new("Folder"); ls.Name="leaderstats"; ls.Parent=player
    local coins=Instance.new("IntValue"); coins.Name="Coins"; coins.Value=0; coins.Parent=ls
    local level=Instance.new("IntValue"); level.Name="Level"; level.Value=1; level.Parent=ls
    local reb=Instance.new("IntValue"); reb.Name="Rebirths"; reb.Value=0; reb.Parent=ls
    local power=Instance.new("IntValue"); power.Name="Power"; power.Value=10; power.Parent=player
    local xp=Instance.new("IntValue"); xp.Name="XP"; xp.Value=0; xp.Parent=player
    local pet=Instance.new("StringValue"); pet.Name="EquippedPet"; pet.Value="None"; pet.Parent=player
    return coins,level,reb,power,xp,pet
end
local function notify(plr,msg)
    Notify:FireClient(plr,msg)
end
local function load(plr)
    local ok,data=pcall(function() return Store:GetAsync("u"..plr.UserId) end)
    if ok and type(data)=="table" then
        local ls=plr:FindFirstChild("leaderstats")
        if ls then
            ls.Coins.Value=tonumber(data.Coins) or 0; ls.Level.Value=tonumber(data.Level) or 1; ls.Rebirths.Value=tonumber(data.Rebirths) or 0
        end
        if plr:FindFirstChild("Power") then plr.Power.Value=tonumber(data.Power) or 10 end
        if plr:FindFirstChild("XP") then plr.XP.Value=tonumber(data.XP) or 0 end
        if plr:FindFirstChild("EquippedPet") then plr.EquippedPet.Value=data.Pet or "None" end
    end
end
local function save(plr)
    local ls=plr:FindFirstChild("leaderstats"); if not ls then return end
    local data={Coins=ls.Coins.Value,Level=ls.Level.Value,Rebirths=ls.Rebirths.Value,Power=plr.Power.Value,XP=plr.XP.Value,Pet=plr.EquippedPet.Value}
    pcall(function() Store:SetAsync("u"..plr.UserId,data) end)
end
Players.PlayerAdded:Connect(function(plr)
    statsFor(plr); load(plr)
    task.delay(2,function() if plr.Parent then notify(plr,"Welcome to LEGO POWER TYCOON! Fight monsters to earn Coins!") end end)
end)
Players.PlayerRemoving:Connect(save)
game:BindToClose(function() for _,p in ipairs(Players:GetPlayers()) do save(p) end end)

local monsterTypes={
    {name="Slime",hp=45,reward=15,xp=12,color=Color3.fromRGB(70,230,100),size=Vector3.new(5,5,5)},
    {name="Brick Goblin",hp=100,reward=40,xp=25,color=Color3.fromRGB(80,170,255),size=Vector3.new(6,7,5)},
    {name="Mega Golem",hp=350,reward=150,xp=80,color=Color3.fromRGB(255,120,65),size=Vector3.new(10,12,9)}
}
local function spawnMonster(kind,pos)
    local model=Instance.new("Model"); model.Name=kind.name; model.Parent=monsterFolder
    local body=Instance.new("Part"); body.Name="Body"; body.Size=kind.size; body.Position=pos; body.Anchored=true; body.CanCollide=true
    body.Color=kind.color; body.Material=Enum.Material.SmoothPlastic; body.Parent=model
    local head=Instance.new("Part"); head.Name="Head"; head.Size=Vector3.new(kind.size.X*.65,kind.size.Y*.35,kind.size.Z*.65)
    head.Position=pos+Vector3.new(0,kind.size.Y*.62,0); head.Anchored=true; head.Color=kind.color; head.Parent=model
    local face=Instance.new("BillboardGui"); face.Size=UDim2.fromOffset(150,48); face.StudsOffset=Vector3.new(0,kind.size.Y*.8,0); face.AlwaysOnTop=true; face.Parent=head
    local txt=Instance.new("TextLabel"); txt.Size=UDim2.fromScale(1,1); txt.BackgroundColor3=Color3.fromRGB(25,25,35); txt.BackgroundTransparency=.2
    txt.Text=kind.name.."  HP: "..kind.hp; txt.TextColor3=Color3.new(1,1,1); txt.TextScaled=true; txt.Font=Enum.Font.FredokaOne; txt.Parent=face
    model.PrimaryPart=body; model:SetAttribute("HP",kind.hp); model:SetAttribute("MaxHP",kind.hp)
    model:SetAttribute("Reward",kind.reward); model:SetAttribute("XP",kind.xp)
    return model
end
local spawnPoints={Vector3.new(-12,3,65),Vector3.new(12,3,75),Vector3.new(-8,3,90),Vector3.new(10,3,100),Vector3.new(65,5,65),Vector3.new(90,5,75),Vector3.new(75,5,90)}
local function fillMonsters()
    for _,kind in ipairs(monsterTypes) do
        local count=(kind.name=="Mega Golem") and 1 or 3
        for i=1,count do
            local pos=spawnPoints[math.random(1,#spawnPoints)] + Vector3.new(math.random(-5,5),0,math.random(-5,5))
            spawnMonster(kind,pos)
        end
    end
end
fillMonsters()

local lastAttack={}
Attack.OnServerEvent:Connect(function(plr)
    local now=os.clock(); if lastAttack[plr] and now-lastAttack[plr]<0.65 then return end; lastAttack[plr]=now
    local char=plr.Character; local root=char and char:FindFirstChild("HumanoidRootPart"); if not root then return end
    local target,dist=nil,13
    for _,m in ipairs(monsterFolder:GetChildren()) do
        if m:IsA("Model") and m.PrimaryPart then
            local d=(m.PrimaryPart.Position-root.Position).Magnitude
            if d<dist then target=m; dist=d end
        end
    end
    if not target then notify(plr,"No monster nearby! Go to Monster Forest."); return end
    local damage=plr.Power.Value*(1+(plr.leaderstats.Rebirths.Value*.25))
    if plr.EquippedPet.Value~="None" then damage=damage*1.5 end
    local hp=math.max(0,target:GetAttribute("HP")-damage); target:SetAttribute("HP",hp)
    local head=target:FindFirstChild("Head"); local label=head and head:FindFirstChildWhichIsA("BillboardGui") and head:FindFirstChildWhichIsA("BillboardGui"):FindFirstChildWhichIsA("TextLabel")
    if label then label.Text=target.Name.."  HP: "..math.ceil(hp) end
    if hp<=0 then
        local ls=plr.leaderstats; local reward=target:GetAttribute("Reward"); ls.Coins.Value+=reward
        plr.XP.Value+=target:GetAttribute("XP")
        local needed=plr.leaderstats.Level.Value*100
        if plr.XP.Value>=needed then plr.XP.Value-=needed; ls.Level.Value+=1; plr.Power.Value+=5; notify(plr,"LEVEL UP! Level "..ls.Level.Value.." | +5 Power") end
        notify(plr,"Monster defeated! +"..reward.." Coins")
        local pos=target.PrimaryPart.Position; target:Destroy()
        task.delay(8,function() if world.Parent then spawnMonster(monsterTypes[math.random(1,2)],pos) end end)
    end
end)
BuyPet.OnServerEvent:Connect(function(plr)
    local ls=plr:FindFirstChild("leaderstats"); if not ls then return end
    if plr.EquippedPet.Value~="None" then notify(plr,"You already own a LEGO Buddy!"); return end
    if ls.Coins.Value<250 then notify(plr,"You need 250 Coins to buy a Pet!"); return end
    ls.Coins.Value-=250; plr.EquippedPet.Value="LEGO Buddy"; notify(plr,"Pet unlocked! Your attacks are 50% stronger!")
end)
Rebirth.OnServerEvent:Connect(function(plr)
    local ls=plr:FindFirstChild("leaderstats"); if not ls then return end
    local cost=1000*(ls.Rebirths.Value+1)
    if ls.Level.Value<10 or ls.Coins.Value<cost then notify(plr,"Need Level 10 and "..cost.." Coins to Rebirth!"); return end
    ls.Coins.Value=0; ls.Level.Value=1; ls.Rebirths.Value+=1; plr.Power.Value=10+ls.Rebirths.Value*5; plr.XP.Value=0
    notify(plr,"REBIRTH COMPLETE! Permanent power bonus increased!")
end)
