<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

local v_u_1 = game:GetService("ReplicatedStorage"):WaitForChild("StudioLiteFolder")
local v_u_2 = script.Parent
local v_u_3 = true
v_u_2.MouseButton1Click:Connect(function()
	-- upvalues: (ref) v_u_3, (copy) v_u_1, (copy) v_u_2
	if v_u_3 then
		v_u_3 = false
		v_u_1.PromptDonation:FireServer(v_u_2.Name)
		task.wait(2)
		v_u_3 = true
	end
end)]]></ProtectedString>
