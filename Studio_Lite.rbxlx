<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

local v_u_1 = script.Parent:WaitForChild("AnimScriptCheckboxImageButton")
local v_u_2 = true
v_u_1.Activated:Connect(function()
	-- upvalues: (ref) v_u_2, (copy) v_u_1
	if v_u_2 then
		v_u_2 = false
		if v_u_1.Image:sub(-8) == "48138491" then
			v_u_1.Image = "http://www.roblox.com/asset/?id=48138474"
			script.Parent:WaitForChild("AnimScriptTextLabel").Text = "Don\'t add script to play this animation."
		else
			v_u_1.Image = "http://www.roblox.com/asset/?id=48138491"
			script.Parent:WaitForChild("AnimScriptTextLabel").Text = "Add script to rig to play this animation."
		end
		task.wait(0.5)
		v_u_2 = true
	end
end)]]></ProtectedString>
