<ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

local v1 = script:WaitForChild("SL_MoveUIDragObjectValue").Value
local v_u_2 = v1.Parent.Parent.Parent
local v_u_3 = v_u_2.Parent
